source "https://rubygems.org"

# Matches the gem versions GitHub Pages uses, so local preview == live site
gem "github-pages", group: :jekyll_plugins
gem "webrick"   # needed for `jekyll serve` on Ruby 3+

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end
